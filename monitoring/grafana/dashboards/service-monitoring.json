{
  "uid": "veyro-service-monitoring",
  "title": "VEYRO - Service Monitoring",
  "tags": ["veyro", "service-monitoring"],
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from": "now-15m", "to": "now"},
  "schemaVersion": 41,
  "version": 1,
  "templating": {"list": [{"name": "environment", "label": "Environment", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(up{application=\"veyro\"}, environment)", "query": {"query": "label_values(up{application=\"veyro\"}, environment)", "refId": "StandardVariableQuery"}, "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": ["$__all"]}}]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Server Status", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "min(up{application=\"veyro\",environment=~\"$environment\"})", "instant": true, "range": false}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}},
    {"id": 2, "type": "stat", "title": "Request Rate", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"veyro\",environment=~\"$environment\",uri!~\"/actuator.*\"}[1m]))", "instant": true, "range": false}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "none"}},
    {"id": 3, "type": "stat", "title": "HTTP 5xx Error Rate", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "(sum(rate(http_server_requests_seconds_count{application=\"veyro\",environment=~\"$environment\",uri!~\"/actuator.*\",status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{application=\"veyro\",environment=~\"$environment\",uri!~\"/actuator.*\"}[1m])) * 100", "instant": true, "range": false}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "none"}},
    {"id": 4, "type": "stat", "title": "p95 Latency", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"veyro\",environment=~\"$environment\",uri!~\"/actuator.*\"}[1m]))) * 1000", "instant": true, "range": false}], "fieldConfig": {"defaults": {"unit": "ms", "decimals": 2}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "none"}},
    {"id": 5, "type": "timeseries", "title": "HTTP Request Rate", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"veyro\",environment=~\"$environment\",uri!~\"/actuator.*\"}[1m]))", "legendFormat": "Request Rate", "range": true}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 6, "type": "timeseries", "title": "HTTP Response Time (AVG / p95 / p99)", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_sum{application=\"veyro\",environment=~\"$environment\",uri!~\"/actuator.*\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"veyro\",environment=~\"$environment\",uri!~\"/actuator.*\"}[1m])) * 1000", "legendFormat": "AVG", "range": true}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"veyro\",environment=~\"$environment\",uri!~\"/actuator.*\"}[1m]))) * 1000", "legendFormat": "p95", "range": true}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"veyro\",environment=~\"$environment\",uri!~\"/actuator.*\"}[1m]))) * 1000", "legendFormat": "p99", "range": true}], "fieldConfig": {"defaults": {"unit": "ms", "decimals": 2, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 7, "type": "timeseries", "title": "HikariCP Connection Pool", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "hikaricp_connections_active{application=\"veyro\",environment=~\"$environment\"}", "legendFormat": "Active", "range": true}, {"refId": "B", "expr": "hikaricp_connections_idle{application=\"veyro\",environment=~\"$environment\"}", "legendFormat": "Idle", "range": true}, {"refId": "C", "expr": "hikaricp_connections_max{application=\"veyro\",environment=~\"$environment\"}", "legendFormat": "Max", "range": true}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}}},
    {"id": 8, "type": "timeseries", "title": "HikariCP Pending Threads", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "hikaricp_connections_pending{application=\"veyro\",environment=~\"$environment\"}", "legendFormat": "Pending", "range": true}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}}},
    {"id": 9, "type": "stat", "title": "Connection Timeout (5m)", "gridPos": {"x": 0, "y": 23, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(hikaricp_connections_timeout_total{application=\"veyro\",environment=~\"$environment\"}[5m]))", "instant": true, "range": false}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "none"}},
    {"id": 10, "type": "stat", "title": "ERROR Logs (5m)", "gridPos": {"x": 12, "y": 23, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(logback_events_total{application=\"veyro\",environment=~\"$environment\",level=\"error\"}[5m]))", "instant": true, "range": false}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "none"}}
  ]
}
