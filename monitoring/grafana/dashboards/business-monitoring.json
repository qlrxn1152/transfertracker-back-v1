{
  "uid": "veyro-business-monitoring",
  "title": "VEYRO - Business Monitoring",
  "tags": ["veyro", "business"],
  "time": {"from": "now-15m", "to": "now"},
  "refresh": "15s",
  "schemaVersion": 41,
  "templating": {"list": [{"name": "environment", "label": "Environment", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(veyro_post_sync_total, environment)", "query": {"query": "label_values(veyro_post_sync_total, environment)"}, "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": ["$__all"]}}]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Failed Posts", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(veyro_post_sync_status{environment=~\"$environment\",status=\"failed\"})", "instant": true, "range": false}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "graphMode": "none"}},
    {"id": 2, "type": "stat", "title": "Stale Processing", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(veyro_post_sync_stale{environment=~\"$environment\"})", "instant": true, "range": false}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "graphMode": "none"}},
    {"id": 3, "type": "stat", "title": "Status Cache Healthy", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "min(veyro_post_sync_status_refresh_success{environment=~\"$environment\"})", "instant": true, "range": false}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "STALE", "color": "red"}, "1": {"text": "OK", "color": "green"}}}]}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "graphMode": "none"}},
    {"id": 4, "type": "stat", "title": "FCM Failures (15m)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(veyro_notification_send_total{environment=~\"$environment\",result=\"failure\"}[15m]))", "instant": true, "range": false}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "graphMode": "none"}},
    {"id": 5, "type": "timeseries", "title": "Post Sync Outcomes", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (step, result) (increase(veyro_post_sync_total{environment=~\"$environment\"}[5m]))", "legendFormat": "{{step}} / {{result}}", "range": true}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 6, "type": "timeseries", "title": "Post Sync Current Status", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (step, status) (veyro_post_sync_status{environment=~\"$environment\"})", "legendFormat": "{{step}} / {{status}}", "range": true}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 7, "type": "timeseries", "title": "Retry Outcomes", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (step, result) (increase(veyro_post_retry_total{environment=~\"$environment\"}[5m]))", "legendFormat": "{{step}} / {{result}}", "range": true}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 8, "type": "timeseries", "title": "FCM Send Outcomes", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (channel, result) (increase(veyro_notification_send_total{environment=~\"$environment\"}[5m]))", "legendFormat": "{{channel}} / {{result}}", "range": true}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}}
  ]
}
